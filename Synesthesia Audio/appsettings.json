{
  "Http": {
    "DlsiteClientTimeoutSeconds": 15,
    "DlsiteApiTimeoutSeconds": 8,
    "DlsiteHtmlTimeoutSeconds": 8,
    "DlsiteTagFetchTimeoutSeconds": 5
  },
  "Translation": {
    "RequestTimeoutSeconds": 6,
    "RateLimitBaseCooldownSeconds": 30,
    "RateLimitMaxCooldownSeconds": 300
  },
  "Proxy": {
    "StreamTimeoutMs": 30000,
    "MaxLogEntries": 500
  },
  "Scan": {
    "MaxParallelDlsiteRequests": 4,
    "ProgressYieldDelayMs": 15
  },
  "App": {
    "DefaultTheme": "Dark"
  }
}
